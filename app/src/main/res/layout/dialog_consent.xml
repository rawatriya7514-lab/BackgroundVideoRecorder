<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_consent_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_consent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transparency &amp; Consent"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_consent_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Please review how this app captures background video with your explicit permission:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/card_dark_stroke" />

    <!-- Point 1 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Manual Activation Only: Recording only runs when you press 'Start Recording'. The app does not record automatically."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- Point 2 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="• Screen-Off &amp; Background Safe: Uses a Foreground Service with WakeLock so turning off your screen does not interrupt the video capture."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- Point 3 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="• Visible System Notification: A persistent notification with a quick 'Stop' action stays active throughout recording."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- Point 4 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="• Local Storage: Videos are saved directly to 'Movies/BackgroundRecorder' on your device. Nothing leaves your phone."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_decline_consent"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Decline"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btn_accept_consent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/record_start_green"
            android:text="Accept &amp; Continue"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
